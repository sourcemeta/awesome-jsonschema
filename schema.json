{
  "$id": "https://raw.githubusercontent.com/jviotti/awesome-jsonschema/master/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "$defs": {
    "base-link": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "name", "url", "description", "type", "level" ],
      "properties": {
        "type": {
          "enum": [
            "Getting Started",
            "Courses",
            "Development Tools",
            "Books",
            "Registries",
            "Articles",
            "Related Specifications",
            "Videos",
            "Papers"
          ]
        },
        "level": {
          "enum": [ "beginner", "intermediate", "advanced" ]
        },
        "subtype": { "type": "string" },
        "year": {
          "type": "integer",
          "minimum": 0
        },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  },
  "items": { "$ref": "#/$defs/base-link" }
}
